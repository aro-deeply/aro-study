rules_version = '2';
// Firebase 콘솔 > Storage > 규칙 탭에 붙여 넣는 용도 (CLI 배포 안 함).
// 앱을 통해 접속(익명 로그인 포함)한 사람만 읽고 올린다. 관련 자료 첨부는 resources/<세션>/<파일> 경로, 20MB 이하.
service firebase.storage {
  match /b/{bucket}/o {
    match /resources/{sessionId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
